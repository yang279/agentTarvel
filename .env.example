# --- Database (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Amap ---
# Web 服务 API key（后端使用）
AMAP_KEY="your_amap_web_key"
# 前端 JS API key（可复用同一 key，需开通「Web端(JS API)」服务类型）
VITE_AMAP_KEY="your_amap_js_key"
# 可选：JS API 安全密钥 securityJsCode
VITE_AMAP_SECURITY_CODE=""

# --- LLM (OpenAI 兼容端点) ---
OPENAI_BASE_URL="https://example.com/v1"
OPENAI_API_KEY="your_api_key"
# 建议使用快模型（如 deepseek-v4-flash）做多节点 agent，pro 为推理模型会较慢
OPENAI_MODEL="deepseek-v4-flash"

# --- Server ---
API_PORT=3001
WEB_PORT=5173
